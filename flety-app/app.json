{
  "expo": {
    "name": "Flety",
    "slug": "flety",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "flety",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.flety.app"
    },
    "android": {
      "package": "com.flety.app",
      "adaptiveIcon": {
        "backgroundColor": "#12161C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": "development"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#12161C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Flety usa tu ubicación para mostrarte en el mapa y coordinar el retiro de tu carga. Si sos chofer, para que tu empresa y el cliente sigan el viaje en vivo."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Flety usa tus fotos para que la empresa y el chofer vean qué vas a mover.",
          "cameraPermission": "Flety usa la cámara para sacar fotos de tu carga."
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true,
          "default": "development"
        }
      },
      "eas": {
        "projectId": "53bbae6d-3ccc-47a1-9aa6-ea9e843a7c03"
      }
    },
    "owner": "etify"
  }
}
