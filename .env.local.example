# Pegar acá las credenciales reales del proyecto Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para uso server-side de confianza (nunca exponer al cliente).
# Necesaria desde Fase 2 (app/api/notify necesita leer suscripciones de otros usuarios).
SUPABASE_SERVICE_ROLE_KEY=

# Fase 2: Google Cloud Console > APIs & Services (Maps JavaScript API + Places API)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Fase 2: generar con `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-email@ejemplo.com
